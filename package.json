{
  "name": "accord",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Accord catches when a Slack decision changes what software should do, investigates the implementation and affected data, and keeps the finding current until resolution is verified.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/channel",
    "apps/web",
    "apps/worker",
    "fixtures/retention-app"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test",
    "test:integration": "node tools/integration.mjs",
    "test:live": "node tools/live.mjs",
    "dev:slack": "npm run dev --workspace channel",
    "dev:worker": "trigger dev",
    "db:migrate": "node --import tsx tools/migrate.ts",
    "demo:seed": "node tools/pending.mjs demo:seed \"Agent 4\" scripts/demo-seed.ts",
    "demo:reset": "node tools/pending.mjs demo:reset \"Agent 4\" scripts/demo-reset.ts",
    "demo:preflight": "node tools/pending.mjs demo:preflight \"Agent 4\" scripts/demo-preflight.ts",
    "demo:prepare-prs": "node tools/pending.mjs demo:prepare-prs \"Agent 4\" scripts/demo-prepare-prs.ts",
    "review:evidence": "node tools/pending.mjs review:evidence \"Agent 4\" scripts/review-evidence.ts",
    "dev:web": "npm run dev --workspace web",
    "channel:status": "npx copilotkit@latest channels status --json",
    "channel:setup": "npx copilotkit@latest channels setup"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "trigger.dev": "4.5.16",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
