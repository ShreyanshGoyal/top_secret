# Accord — shared team configuration.
#
# TRACKED IN GIT at the team's explicit decision, so all four workstreams run against the same
# services. The repository is private. Two consequences to keep in mind:
#   1. 06-ACCEPTANCE-AND-REVIEW checklist item "no secret files committed" fails while this exists.
#      Delete this file and rotate these keys before the review commit.
#   2. Git history keeps every value ever committed here. Rotating is the only real removal.
#
# Use it:   cp team.env .env
# .env itself stays gitignored, so your own local-only values never get committed by accident.

# ── Mode ─────────────────────────────────────────────────────────────────────
ACCORD_MODE=demo
PORT=3000

# ── Trigger.dev ──────────────────────────────────────────────────────────────
TRIGGER_PROJECT_REF=proj_cctznktvccdrxqflonqq
TRIGGER_SECRET_KEY=tr_dev_sk_In6RYaYhO9kQwxvJTpgfEvQP

# ── PostgreSQL · matches infra/compose.yaml ─────────────────────────────────
DATABASE_URL=postgres://accord_admin:local-development-only@localhost:5432/accord
# Throwaway database for `npm run test:integration`. It creates and drops its own schema.
ACCORD_TEST_DATABASE_URL=postgres://accord_admin:local-development-only@localhost:5432/accord

# ── ClickHouse · matches infra/compose.yaml ─────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=accord_demo
# Seed-only admin identity. Never put these in the bridge or worker environment.
ACCORD_CLICKHOUSE_ADMIN_USER=accord_admin
ACCORD_CLICKHOUSE_ADMIN_PASSWORD=local-development-only
# Restricted runtime identity. Create it once against the admin user, then fill these in:
#   docker compose -f infra/compose.yaml exec clickhouse clickhouse-client \
#     --user accord_admin --password local-development-only \
#     --query "CREATE USER IF NOT EXISTS accord_runtime IDENTIFIED WITH sha256_password BY '<password>'; \
#              GRANT accord_runtime_readonly TO accord_runtime;"
CLICKHOUSE_USER=accord_runtime
CLICKHOUSE_PASSWORD=38a95d30348860f57aff831ad02a2dd313aab5aa51ad2f8c

# ── Dataset · fixed, must match infra/clickhouse/seed/*.json ────────────────
ACCORD_DATASET_VERSION=accord-demo-2026-09-12
ACCORD_DEMO_AS_OF=2026-09-12T00:00:00.000Z
ACCORD_DEMO_RESET_ENABLED=false

